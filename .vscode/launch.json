{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Запуск C++ проекта (с картинками)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\bin\\main.exe",
            "args": [
                "data\\input.bmp",
                "data\\output.bmp"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:\\1\\msys64\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Сборка C++ проекта"
        }
    ]
}
