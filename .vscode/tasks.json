{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "Сборка C++ проекта",
			"command": "D:\\1\\msys64\\ucrt64\\bin\\g++.exe",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"-std=c++20",
				"${workspaceFolder}\\src\\*.cpp",
				"-o",
				"${workspaceFolder}\\bin\\main.exe",
				"-I",
				"${workspaceFolder}\\include",
				"-Wall"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: D:\\1\\msys64\\ucrt64\\bin\\g++.exe"
		}
	]
}